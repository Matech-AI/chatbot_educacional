# Configuração de ambiente para Coolify - DNA da Força AI
# Este arquivo contém as variáveis de ambiente necessárias para o deploy no Coolify

# ========================================
# CONFIGURAÇÕES DO COOLIFY
# ========================================
COOLIFY_DEPLOYMENT_UUID=qkkc0gg0gwwk04sk0ww48gcw
COOLIFY_API_URL=http://31.97.16.142:8000/api/v1
COOLIFY_FORCE_DEPLOY=false

# ========================================
# CONFIGURAÇÕES DOS SERVIDORES
# ========================================
# API Server (Porta 8002)
API_PORT=8002
API_HOST=0.0.0.0
API_LOG_LEVEL=INFO

# RAG Server (Porta 8001)
RAG_PORT=8001
RAG_HOST=0.0.0.0
RAG_LOG_LEVEL=INFO

# Frontend (Porta 3000)
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0

# ========================================
# CONFIGURAÇÕES DE REDE E CORS
# ========================================
# URLs dos serviços
API_BASE_URL=https://iadnadaforca.com.br/api
RAG_API_BASE_URL=https://iadnadaforca.com.br/rag
RAG_SERVER_URL=http://rag-server:8001
FRONTEND_URL=https://iadnadaforca.com.br

# CORS Origins
CORS_ORIGINS=https://iadnadaforca.com.br,https://www.iadnadaforca.com.br,http://localhost:3000,http://127.0.0.1:3000

# ========================================
# CONFIGURAÇÕES DE AMBIENTE
# ========================================
NODE_ENV=production
PYTHON_ENV=production
LOG_LEVEL=INFO

# ========================================
# CONFIGURAÇÕES DE DADOS
# ========================================
MATERIALS_DIR=/app/data/materials
CHROMADB_DIR=/app/data/chromadb
BACKUP_DIR=/app/data/backup
LOGS_DIR=/app/logs

# ========================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO
# ========================================
# JWT
# JWT_SECRET_KEY=your-secret-key-here

# IA — preencha pelo menos uma das três
# OPENAI_API_KEY=your-openai-api-key-here
# NVIDIA_API_KEY=your-nvidia-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Google Drive API (service account)
# GOOGLE_DRIVE_API_KEY=your-google-drive-api-key-here
GOOGLE_CREDENTIALS_PATH=/app/backend/credentials.json

# Google OAuth2 — OBRIGATÓRIO para sincronização com Drive privado
# Obtenha em: console.cloud.google.com → Credenciais → OAuth 2.0 → Tipo "Web application"
# URI de redirecionamento autorizado: https://iadnadaforca.com.br/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here

# ========================================
# CONFIGURAÇÕES DE E-MAIL
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=matheusbnas@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=matheusbnas@gmail.com
ENVIRONMENT=production

# ========================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ========================================
DATABASE_URL=postgresql://postgres:password@postgres:5432/dna_da_forca
POSTGRES_DB=dna_da_forca
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ========================================
# CONFIGURAÇÕES SUPABASE (OPCIONAL)
# ========================================
SUPABASE_URL=https://bqvhtyodlsjcjitunmvs.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ========================================
# CONFIGURAÇÕES DE DOMÍNIO
# ========================================
DOMAIN=iadnadaforca.com.br
